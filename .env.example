# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

# --- ENTSO-E Transparency Platform ---
# Free to obtain, but requires manual steps (no self-serve signup form):
#   1. Register an account at https://transparency.entsoe.eu/
#   2. Email transparency@entsoe.eu from your registered address, subject
#      "Restful API access", asking for API access to be enabled on your account.
#   3. Once enabled, generate a token at:
#      https://transparency.entsoe.eu/usrm/user/myAccountSettings
#      ("Web Api Security Token" section).
# If you don't have a token yet, ingest_energy.py automatically falls back to
# SMARD (Bundesnetzagentur), Germany's grid data portal, which needs no key at all.
ENTSOE_API_TOKEN=

# --- Open-Meteo ---
# No API key required for the free/non-commercial tier used here.

# --- Location used throughout the pipeline (default: Dortmund, NRW, Germany) ---
LOCATION_NAME=Dortmund
LOCATION_LAT=51.5136
LOCATION_LON=7.4653

# --- ENTSO-E bidding zone / area EIC code for Germany (used only if ENTSOE_API_TOKEN is set) ---
# Used by ingest_energy.py for load/generation queries.
ENTSOE_AREA_CODE=10Y1001A1001A83F

# --- ENTSO-E DE-LU price bidding zone EIC code (used only if ENTSOE_API_TOKEN is set) ---
# Used by ingest_price.py for query_day_ahead_prices. Deliberately different
# from ENTSOE_AREA_CODE above: query_day_ahead_prices raises NoMatchingDataError
# against the generic "DE" code that load/generation queries accept -- it needs
# the actual DE-LU bidding zone EIC code, confirmed empirically.
ENTSOE_PRICE_AREA_CODE=10Y1001A1001A82H
